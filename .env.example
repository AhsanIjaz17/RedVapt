# RedVapt Environment Configuration Example
# Copy this file to .env and configure your local settings.

# --- AI / LLM Providers ---
# Get keys from https://console.anthropic.com or https://openrouter.ai
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Server Configuration ---
SERVER_PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Security Tool Paths (Optional overrides) ---
# LINKFINDER_PATH=/path/to/linkfinder.py
# GO_BIN_PATH=/path/to/go/bin
# LOCAL_BIN_PATH=/path/to/local/bin

# --- Recon Tool Timeouts (in milliseconds) ---
TIMEOUT_GAU=480000
TIMEOUT_WAYBACKURLS=360000
TIMEOUT_FFUF=480000
TIMEOUT_KATANA=480000

# --- Database & Authentication ---
DATABASE_URL=sqlite://./redvapt.db
DB_TYPE=sqlite

# --- JWT Secrets ---
JWT_ACCESS_SECRET=your_dev_access_secret_change_in_production
JWT_REFRESH_SECRET=your_dev_refresh_secret_change_in_production

# --- Google OAuth (Optional) ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# --- Frontend URL ---
FRONTEND_URL=http://localhost:3000
